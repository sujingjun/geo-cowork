{
  "name": "geo-cowork",
  "version": "0.3.0",
  "private": true,
  "description": "本地优先的企业品牌 GEO 专家插件与品牌工作区",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:m2-contract": "node --test tests/m2-*.test.mjs",
    "test:m3-knowledge-query": "node --test tests/m3-knowledge-query.test.mjs",
    "test:m4-diagnosis": "node --test tests/m4-*.test.mjs",
    "test:m5-answer": "node --test tests/m5-*.test.mjs",
    "test:m6-cycle": "node --test tests/m6-*.test.mjs",
    "test:m7-strategy": "node --test tests/m7-*.test.mjs",
    "test:m8-conformance": "node --test tests/m8-conformance.test.mjs",
    "test:query-portfolio": "node --test tests/query-portfolio*.test.mjs",
    "test:analytics-readonly": "node --test tests/analytics-readonly*.test.mjs",
    "analytics:readonly": "node plugins/geo-expert/scripts/geo-analytics-readonly.mjs",
    "conformance:m8": "node plugins/geo-expert/scripts/geo-conformance.mjs",
    "setup:analytics-readonly": "bash plugins/geo-expert/scripts/setup-google-analytics-readonly.sh",
    "smoke:m5-playwright": "node plugins/geo-expert/scripts/answer-cycle.mjs runtime-smoke --workspace workspaces/myyshop --version 1.62.1",
    "collect:m4-public": "node plugins/geo-expert/scripts/collect-public-site.mjs",
    "prepare:m4-public-inputs": "node plugins/geo-expert/scripts/prepare-public-site-m4-inputs.mjs",
    "check:docs": "node plugins/geo-expert/scripts/check-doc-links.mjs",
    "validate:plugin": "node plugins/geo-expert/scripts/validate-plugin.mjs",
    "dev:browser-query": "node plugins/geo-expert/scripts/geo-runtime.mjs browser",
    "query:portfolio": "node plugins/geo-expert/scripts/query-portfolio.mjs",
    "collect:playwright": "node plugins/geo-expert/scripts/geo-playwright.mjs",
    "test:query-inputs": "node --test tests/query-inputs.test.mjs",
    "demo:geo-e2e": "node plugins/geo-expert/scripts/demo-knowledge-journey.mjs",
    "test:semantic-quality": "node plugins/geo-expert/scripts/validate-semantic-quality.mjs",
    "validate:geo-e2e": "node plugins/geo-expert/scripts/validate-knowledge-journey.mjs",
    "format:geo-e2e": "prettier --single-quote --trailing-comma all --write 'plugins/geo-expert/scripts/lib/{model-client,query-inputs,capture-run,playwright-collector,playwright-mcp-client,owner-feedback,knowledge-workspace,knowledge-markdown,snapshot-support,sampling-matrix,proposal-revision,journey-*}.mjs' 'plugins/geo-expert/scripts/{geo-playwright,geo-runtime,demo-knowledge-journey,validate-semantic-quality,validate-knowledge-journey}.mjs' 'tests/{capture-run,owner-feedback,query-inputs,source-maintenance,snapshot-support,knowledge-markdown,journey-lock}.test.mjs'",
    "format:check": "prettier --single-quote --trailing-comma all --check 'plugins/geo-expert/scripts/lib/{model-client,query-inputs,capture-run,playwright-collector,playwright-mcp-client,owner-feedback,knowledge-workspace,knowledge-markdown,snapshot-support,sampling-matrix,proposal-revision,journey-*}.mjs' 'plugins/geo-expert/scripts/{geo-playwright,geo-runtime,demo-knowledge-journey,validate-semantic-quality,validate-knowledge-journey}.mjs' 'tests/{capture-run,owner-feedback,query-inputs,source-maintenance,snapshot-support,knowledge-markdown,journey-lock}.test.mjs' 'plugins/geo-expert/scripts/lib/{real-analytics,real-cycle-*,real-diagnosis,real-journey*,real-knowledge,real-publication,real-sampling}.mjs' 'tests/real-*.test.mjs' 'tests/helpers/real-*.mjs' 'plugins/geo-expert/scripts/oneglanse.mjs' 'plugins/geo-expert/scripts/lib/oneglanse-*.mjs' 'tests/oneglanse-intake.test.mjs'",
    "test:real-cycle": "node --test tests/real-*.test.mjs",
    "format:real-cycle": "prettier --single-quote --trailing-comma all --write 'plugins/geo-expert/scripts/lib/{real-analytics,real-cycle-*,real-diagnosis,real-journey*,real-knowledge,real-publication,real-sampling}.mjs' 'tests/real-*.test.mjs' 'tests/helpers/real-*.mjs'",
    "oneglanse": "node plugins/geo-expert/scripts/oneglanse.mjs",
    "test:oneglanse": "node --test tests/oneglanse-intake.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "google-auth-library": "10.9.1",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.81",
    "prettier": "3.6.2"
  }
}
