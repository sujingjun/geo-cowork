{
  "schema_version": "m6-sensitive-data-policy/1.0.0",
  "id": "sensitive-data-policy-m6-fixture-v1",
  "version": "1.0.0",
  "scope": "test_only",
  "allowed_fields": [
    "schema_version",
    "time_window",
    "metrics",
    "metric_id",
    "value",
    "unit",
    "dimensions"
  ],
  "forbidden_field_patterns": [
    "email",
    "phone",
    "ip",
    "cookie",
    "authorization",
    "token",
    "secret",
    "password"
  ],
  "max_input_bytes": 65536,
  "unknown_binary": "reject"
}
