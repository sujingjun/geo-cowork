# 复制为本地 .env 后再填写；.env 已被仓库忽略，禁止提交 token、cookie、
# OAuth client secret、service-account JSON 或任何凭据正文。

# ===== M4 MyyShop 公开站点采集：均为非秘密默认值 =====
# URL allowlist 不放在环境变量中，权威范围见：
# workspaces/myyshop/cycles/preparation/decisions/2026-08-24-m4-public-collection-authorized.md
M4_PUBLIC_SITE_ORIGIN=https://www.myyshop.com
M4_HTTP_USER_AGENT=geo-cowork-m4/0.3.0
M4_HTTP_ACCEPT_LANGUAGE=en-US,en;q=0.9
M4_HTTP_CONCURRENCY=1
M4_HTTP_REQUEST_INTERVAL_MS=1000
M4_HTTP_TIMEOUT_MS=20000
M4_HTTP_MAX_RETRIES=2
M4_HTTP_MAX_REDIRECTS=5
M4_HTTP_MAX_RESPONSE_BYTES=5242880
M4_RAW_RETENTION_DAYS=90
M4_REVIEWER_ROLE="MyyShop Owner"

# ===== GA4：本轮只准备配置，不读取账号数据 =====
# Web stream Measurement ID（G- 开头）已由 Owner 提供；它不是 Data API
# 所需的 numeric Property ID。获取路径：GA4 Admin > Data streams > Web stream。
# 官方说明：https://support.google.com/analytics/answer/12270356?hl=en
GA4_MEASUREMENT_ID=G-3HEVBJ08SH

# 待确认：纯数字 GA4 Property ID。获取路径：GA4 Admin > Property settings。
# Data API 使用 properties/GA4_PROPERTY_ID。
# 官方说明：https://developers.google.com/analytics/devguides/reporting/data/v1/property-id
GA4_PROPERTY_ID=356373250

# ===== Google Search Console：本轮只准备配置，不读取账号数据 =====
# 待确认：必须从 Search Console property selector 复制精确资源标识。
# Domain property 示例：sc-domain:myyshop.com
# URL-prefix property 示例：https://www.myyshop.com/
# 不要仅填写 www.myyshop.com，因为两种 property 的覆盖范围不同。
# 官方说明：https://support.google.com/webmasters/answer/34592?hl=en
GSC_SITE_URL=https://www.myyshop.com/

# ===== GA4/GSC 共用的未来只读认证占位 =====
# 待确认：启用对应 API 的 Google Cloud project ID；这不是 secret。
GOOGLE_CLOUD_PROJECT=

# 可选：本机凭据文件的绝对路径，只填路径，绝不提交文件或内容。
# 本地也可使用 `gcloud auth application-default login` 建立 ADC，而不填写本项。
# 官方说明：https://cloud.google.com/docs/authentication/provide-credentials-adc
GOOGLE_APPLICATION_CREDENTIALS=

# GSC 未来读取必须请求 read-only scope：
# https://www.googleapis.com/auth/webmasters.readonly
# 官方授权说明：https://developers.google.com/webmaster-tools/v1/how-tos/authorizing
