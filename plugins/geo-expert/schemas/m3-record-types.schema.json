{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-cowork.local/schemas/m3-record-types-v1.json",
  "$defs": {
    "query": {
      "required": ["normalized_text", "intent", "priority", "goal_refs"],
      "properties": {
        "normalized_text": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "goal_refs": { "$ref": "common#/$defs/stringArray" },
        "discovery_source_refs": { "$ref": "common#/$defs/stringArray" },
        "legacy_refs": { "$ref": "common#/$defs/stringArray" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "claim": {
      "required": ["document_refs", "scope", "evidence_sufficiency"],
      "properties": {
        "document_refs": { "$ref": "common#/$defs/stringArray" },
        "scope": { "type": "string", "minLength": 1 },
        "evidence_sufficiency": {
          "type": "object",
          "required": ["status", "rule_version", "missing"],
          "properties": {
            "status": { "enum": ["sufficient", "insufficient", "unknown"] },
            "rule_version": { "const": "m3-evidence-sufficiency-v1" },
            "missing": { "$ref": "common#/$defs/stringArray" }
          },
          "additionalProperties": false
        },
        "release_refs": { "$ref": "common#/$defs/stringArray" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "evidence": {
      "properties": {
        "scope": { "type": "string" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "document": {
      "x-id-prefix": "DOC-",
      "x-statuses": ["draft", "reviewed", "approved", "stale", "deprecated"],
      "required": ["scope", "source_refs"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "legacy_refs": { "$ref": "common#/$defs/stringArray" },
        "claim_refs": { "$ref": "common#/$defs/stringArray" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "answer_card": {
      "x-id-prefix": "ANS-",
      "x-statuses": ["candidate", "reviewed", "approved", "published", "stale", "deprecated"],
      "required": ["query_refs", "claim_versions", "direct_answer", "limitations", "forbidden_statements"],
      "properties": {
        "query_refs": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "claim_versions": {
          "type": "array",
          "items": { "$ref": "common#/$defs/refVersion" },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_refs": { "$ref": "common#/$defs/stringArray" },
        "direct_answer": { "type": "string", "minLength": 1 },
        "limitations": { "$ref": "common#/$defs/stringArray" },
        "forbidden_statements": { "$ref": "common#/$defs/stringArray" },
        "release_refs": { "$ref": "common#/$defs/stringArray" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "knowledge_release": {
      "x-id-prefix": "KR-",
      "x-statuses": ["draft", "reviewed", "published", "superseded"],
      "required": ["release_version", "claim_versions", "answer_card_versions", "readiness"],
      "properties": {
        "release_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "claim_versions": {
          "type": "array",
          "items": { "$ref": "common#/$defs/refVersion" },
          "minItems": 1,
          "uniqueItems": true
        },
        "answer_card_versions": {
          "type": "array",
          "items": { "$ref": "common#/$defs/refVersion" },
          "minItems": 1,
          "uniqueItems": true
        },
        "readiness": { "enum": ["ready", "incomplete"] },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "query_set": {
      "x-id-prefix": "QS-",
      "x-statuses": ["draft", "frozen", "superseded"],
      "required": ["goal_refs", "query_versions"],
      "properties": {
        "goal_refs": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "query_versions": {
          "type": "array",
          "items": { "$ref": "common#/$defs/refVersion" },
          "minItems": 1,
          "uniqueItems": true
        },
        "frozen_at": { "$ref": "common#/$defs/rfc3339" },
        "frozen_by": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "common#/$defs/sha256" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    },
    "evidence_plan": {
      "x-id-prefix": "EPL-",
      "x-statuses": ["draft", "active", "fulfilled", "superseded"],
      "required": [
        "claim_refs",
        "current_gap",
        "required_evidence",
        "minimum_acceptance",
        "source_categories",
        "provider_owner",
        "acceptance_method",
        "retest_query_refs"
      ],
      "properties": {
        "claim_refs": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "current_gap": { "type": "string", "minLength": 1 },
        "required_evidence": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "minimum_acceptance": { "type": "string", "minLength": 1 },
        "source_categories": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "provider_owner": { "type": "string", "minLength": 1 },
        "acceptance_method": { "type": "string", "minLength": 1 },
        "retest_query_refs": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 }
      }
    },
    "perception_goal": {
      "x-id-prefix": "GOAL-",
      "x-statuses": ["candidate", "approved", "active", "achieved", "partial", "not_achieved", "deprecated"],
      "required": ["goal_statement", "success_question"],
      "properties": {
        "goal_statement": { "type": "string", "minLength": 1 },
        "success_question": { "type": "string", "minLength": 1 },
        "query_set_refs": { "$ref": "common#/$defs/stringArray" },
        "approval": { "$ref": "common#/$defs/approval" }
      }
    }
  }
}
