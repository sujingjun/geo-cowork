{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-cowork.local/schemas/common-object-v1.json",
  "$defs": {
    "common": {
      "required": [
        "id",
        "record_type",
        "status",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "record_type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "created_at": {
          "$ref": "#/$defs/rfc3339"
        },
        "updated_at": {
          "$ref": "#/$defs/rfc3339"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "test_scope": {
          "type": "object",
          "required": ["kind", "usage", "merchant_ref", "workspace_id"],
          "properties": {
            "kind": { "const": "synthetic" },
            "usage": { "const": "test_only" },
            "merchant_ref": {
              "type": "string",
              "pattern": "^TMT-(?:[A-Z0-9]+-)*[A-Z0-9]+$"
            },
            "workspace_id": {
              "type": "string",
              "pattern": "^ws_[a-z0-9]{26}$"
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "additionalProperties": true
        }
      }
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "refVersion": {
      "type": "object",
      "required": ["ref", "version"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at", "decision_ref"],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "$ref": "#/$defs/rfc3339"
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
