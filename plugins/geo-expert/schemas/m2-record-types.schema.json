{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-cowork.local/schemas/m2-record-types-v1.json",
  "$defs": {
    "query": {
      "x-id-prefix": "Q-",
      "x-statuses": ["candidate", "formal", "stale", "deprecated"],
      "required": ["query_text", "language"],
      "properties": {
        "query_text": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "claim": {
      "x-id-prefix": "CLM-",
      "x-statuses": [
        "candidate",
        "evidence_ready",
        "reviewed",
        "approved",
        "published",
        "stale",
        "deprecated"
      ],
      "required": ["statement", "risk_type", "risk_level"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "risk_type": {
          "enum": [
            "ordinary_fact",
            "capability_fact",
            "effect_claim",
            "comparison_claim",
            "high_risk_commitment"
          ]
        },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "evidence_refs": { "$ref": "common#/$defs/stringArray" }
      }
    },
    "source": {
      "x-id-prefix": "SRC-",
      "x-statuses": ["active", "stale", "deprecated"],
      "required": ["name", "source_kind", "locator"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "x-id-prefix": "EVD-",
      "x-statuses": ["candidate", "reviewed", "approved", "stale", "deprecated"],
      "required": ["source_refs", "locator", "captured_at", "snapshot", "collector"],
      "properties": {
        "source_refs": { "$ref": "common#/$defs/stringArray", "type": "array", "minItems": 1 },
        "claim_refs": { "$ref": "common#/$defs/stringArray" },
        "locator": { "type": "string", "minLength": 1 },
        "captured_at": { "$ref": "common#/$defs/rfc3339" },
        "snapshot": {
          "type": "object",
          "required": ["path", "sha256", "media_type"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "common#/$defs/sha256" },
            "media_type": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "collector": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "finding": {
      "x-id-prefix": "FND-",
      "x-statuses": ["open", "waiting_human", "resolved", "dismissed", "superseded"],
      "required": ["finding_code", "finding_kind", "item_state", "rule_version"],
      "properties": {
        "finding_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "finding_kind": { "enum": ["technical", "semantic", "legacy_observation"] },
        "item_state": { "enum": ["observed", "inferred", "unverifiable", "blocked"] },
        "rule_version": { "type": "string", "minLength": 1 },
        "query_refs": { "$ref": "common#/$defs/stringArray" },
        "claim_refs": { "$ref": "common#/$defs/stringArray" },
        "evidence_refs": { "$ref": "common#/$defs/stringArray" },
        "asset_refs": { "$ref": "common#/$defs/stringArray" }
      }
    },
    "asset": {
      "x-id-prefix": "AST-",
      "x-statuses": ["candidate", "active", "stale", "deprecated"],
      "required": ["asset_kind", "locator"],
      "properties": {
        "asset_kind": { "enum": ["own", "external"] },
        "locator": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "common#/$defs/stringArray" }
      }
    },
    "run": {
      "x-id-prefix": "RUN-",
      "x-statuses": [
        "pending",
        "running",
        "waiting_human",
        "blocked",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ],
      "required": [
        "skill",
        "skill_version",
        "input_refs",
        "input_versions",
        "input_fingerprint",
        "completed_steps",
        "output_artifacts",
        "business_result",
        "next_action"
      ],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "minLength": 1 },
        "input_refs": { "$ref": "common#/$defs/stringArray" },
        "input_versions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "input_fingerprint": { "$ref": "common#/$defs/sha256" },
        "completed_steps": { "$ref": "common#/$defs/stringArray" },
        "output_artifacts": { "$ref": "common#/$defs/stringArray" },
        "business_result": { "enum": ["not_evaluated", "pass", "partial", "fail", "inconclusive"] },
        "next_action": { "type": "string" },
        "finding_refs": { "$ref": "common#/$defs/stringArray" },
        "evidence_refs": { "$ref": "common#/$defs/stringArray" },
        "asset_refs": { "$ref": "common#/$defs/stringArray" },
        "failure_reason": { "type": ["string", "null"] },
        "supersedes_ref": { "type": "string", "pattern": "^RUN-(?:[A-Z0-9]+-)*[A-Z0-9]+$" },
        "superseded_by_ref": { "type": "string", "pattern": "^RUN-(?:[A-Z0-9]+-)*[A-Z0-9]+$" }
      }
    },
    "cycle": {
      "x-id-prefix": "CYC-",
      "x-statuses": ["proposed", "active", "waiting_human", "completed", "cancelled", "superseded"],
      "required": ["core_versions"],
      "properties": {
        "core_versions": {
          "type": "object",
          "additionalProperties": { "$ref": "common#/$defs/refVersion" }
        }
      }
    }
  }
}
