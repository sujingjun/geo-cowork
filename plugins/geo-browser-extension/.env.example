# Password for nuxt-auth-utils (minimum 32 characters)
NUXT_SESSION_PASSWORD=
# GitHub OAuth client ID
NUXT_OAUTH_GITHUB_CLIENT_ID=
# GitHub OAuth client secret
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# Google OAuth client ID
NUXT_OAUTH_GOOGLE_CLIENT_ID=
# Google OAuth client secret
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Amazon Selling Partner App application ID
AMAZON_SP_API_APPLICATION_ID=
# Amazon Login with Amazon client ID (Selling Partner App LWA client)
NUXT_OAUTH_AMAZON_CLIENT_ID=
# Amazon Login with Amazon client secret
NUXT_OAUTH_AMAZON_CLIENT_SECRET=
# Sandbox token created from Solution Provider Portal > app actions > Create Token
AMAZON_SP_API_SANDBOX_REFRESH_TOKEN=
# Set to beta when authorizing a Draft Selling Partner App
AMAZON_SP_API_AUTH_VERSION=
# Use sandbox for development SP-API calls; use production only after validation
AMAZON_SP_API_ENVIRONMENT=production
# Seller Central authorization endpoint, defaults to North America
AMAZON_SELLER_CENTRAL_AUTHORIZE_URL=https://sellercentral.amazon.com/apps/authorize/consent
# Amazon SP-API region and marketplace
AMAZON_SP_API_REGION=us-east-1
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# Leave empty to auto-select from AMAZON_SP_API_ENVIRONMENT and AMAZON_SP_API_REGION.
# North America sandbox: https://sandbox.sellingpartnerapi-na.amazon.com
# North America production: https://sellingpartnerapi-na.amazon.com
AMAZON_SP_API_ENDPOINT=
# Shopify app id and secret
NUXT_OAUTH_SHOPIFY_CLIENT_ID=
NUXT_OAUTH_SHOPIFY_CLIENT_SECRET=
# Vercel AI gateway key
AI_GATEWAY_API_KEY=
# Blob read write token
BLOB_READ_WRITE_TOKEN=
# PostgreSQL connection string (optional locally, required in production)
DATABASE_URL=
# self model
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Public canonical site URL, for example https://geo-site-building-web.example.com
NUXT_PUBLIC_SITE_URL=