{
  "name": "geo-site-building-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nuxt build",
    "build:extension": "node scripts/build-extension.mjs",
    "dev": "nuxt dev",
    "fixture:extension": "node scripts/fixture-platform-server.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:extension": "node --test tests/bootstrap.test.mjs",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:sql": "node scripts/db-sql.mjs",
    "db:tables": "node scripts/db-sql.mjs \"select table_name from information_schema.tables where table_schema = 'public' order by table_name\"",
    "db:seed": "curl -X POST http://localhost:3000/api/db/seed || echo '\n⚠️  Please ensure dev server is running (pnpm dev)'",
    "check:env": "node scripts/check-env.mjs",
    "check:env:production": "node scripts/check-env.mjs --file .vercel/.env.production.local --production",
    "vercel:pull:prod": "pnpm dlx vercel@54.14.0 pull --yes --environment=production",
    "vercel:build:prod": "pnpm dlx vercel@54.14.0 build --prod --yes",
    "vercel:deploy:prod": "pnpm dlx vercel@54.14.0 deploy --prod --yes",
    "vercel:deploy:prebuilt:prod": "pnpm dlx vercel@54.14.0 deploy --prebuilt --prod --yes",
    "deploy:prod": "pnpm vercel:pull:prod && pnpm check:env:production && pnpm typecheck && pnpm vercel:deploy:prod",
    "deploy:prod:prebuilt": "pnpm vercel:pull:prod && pnpm check:env:production && pnpm typecheck && pnpm vercel:build:prod && pnpm vercel:deploy:prebuilt:prod",
    "test:deepseek": "node scripts/check-deepseek.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/gateway": "^3.0.116",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/vue": "^3.0.185",
    "@comark/nuxt": "^0.3.1",
    "@electric-sql/pglite": "^0.5.2",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.108",
    "@iconify-json/simple-icons": "^1.2.83",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "1.1.1",
    "@nuxt/test-utils": "4.0.3",
    "@nuxt/ui": "^4.7.1",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/emotion": "1.0.2",
    "@nuxtjs/seo": "5.1.3",
    "@shikijs/langs": "^4.0.2",
    "@takumi-rs/core": "^1.4.1",
    "@vercel/blob": "^2.4.0",
    "@vueuse/core": "^14.3.0",
    "ai": "^6.0.185",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.6",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-charts": "^2.1.4",
    "nuxt-csurf": "^1.6.5",
    "postgres": "^3.4.9",
    "shiki": "^4.0.2",
    "striptags": "3.2.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "happy-dom": "^20.9.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.0"
  },
  "packageManager": "pnpm@11.1.3"
}
