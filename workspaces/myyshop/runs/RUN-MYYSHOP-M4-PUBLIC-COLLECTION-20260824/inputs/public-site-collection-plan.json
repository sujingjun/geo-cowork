{
  "schema_version": "1.0.0",
  "run_id": "RUN-MYYSHOP-M4-PUBLIC-COLLECTION-20260824",
  "origin": "https://www.myyshop.com",
  "development_fixture": false,
  "collector": {
    "name": "geo-cowork-public-site",
    "version": "0.3.0",
    "mode": "public_http"
  },
  "request": {
    "user_agent": "geo-cowork-m4/0.3.0",
